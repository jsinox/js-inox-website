---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { faq } from '@data/faq';
---
<section class="section faq" id="duvidas" aria-labelledby="faq-title">
  <Container class="faq__container">
    <div class="faq__intro">
      <SectionHeading eyebrow="Perguntas frequentes" title="Informação clara antes de avançar." description="Veja o que é importante considerar ao apresentar uma necessidade." />
      <a class="text-link" href="#formulario">Organizar minha demanda <span aria-hidden="true">↗</span></a>
    </div>
    <div class="faq-list">
      {faq.map((item, index) => (
        <details class="faq-item">
          <summary><span class="faq-item__number">{String(index + 1).padStart(2, '0')}</span><span class="faq-item__question">{item.question}</span><span class="faq-item__toggle" aria-hidden="true"></span></summary>
          <div class="faq-item__answer"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </Container>
</section>