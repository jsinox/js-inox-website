---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  centered?: boolean;
  light?: boolean;
}
const { eyebrow, title, description, centered = false, light = false } = Astro.props;
---
<div class:list={['section-heading', centered && 'section-heading--centered', light && 'section-heading--light']}>
  <p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>{eyebrow}</p>
  <h2>{title}</h2>
  {description && <p class="section-heading__description">{description}</p>}
</div>